<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="partner_category_ai_contact" model="res.partner.category">
            <field name="name">AI Contact</field>
        </record>

        <!-- Dispatcher: runs the AI replies in the cron process (triggered by every
             new job; the interval is the recovery of lost jobs). See ai_job.py. -->
        <record id="ir_cron_run_ai_jobs" model="ir.cron">
            <field name="name">AI Contacts: Run AI Replies</field>
            <field name="model_id" ref="model_woow_ai_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_jobs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="priority">1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_cleanup_ai_logs" model="ir.cron">
            <field name="name">AI Contacts: Delete Old Call Logs and Jobs</field>
            <field name="model_id" ref="model_woow_ai_call_log"/>
            <field name="state">code</field>
            <field name="code">model._cleanup_old_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
    <!-- 18.0.1.0.0 had a separate recovery cron: merged into the dispatcher -->
    <delete model="ir.cron" search="[('code', '=', 'model._cron_recover_jobs()')]"/>
    <delete model="ir.actions.server" search="[('usage', '=', 'ir_cron'), ('code', '=', 'model._cron_recover_jobs()')]"/>
</odoo>
