<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Owner decision 25: Live Chat managers may pick ANY AI contact (names only: the backend
             fields stay restricted to system administrators). Contacts only used by Live Chat have no
             allowed groups, so the core rule alone would hide them. -->
        <record id="rule_woow_ai_contact_livechat_manager" model="ir.rule">
            <field name="name">AI contact: Live Chat managers read every contact</field>
            <field name="model_id" ref="woow_ai_contact.model_woow_ai_contact"/>
            <field name="groups" eval="[Command.link(ref('im_livechat.im_livechat_group_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
